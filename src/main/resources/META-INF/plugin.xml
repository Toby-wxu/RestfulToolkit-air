<idea-plugin url="https://github.com/Toby-wxu/RestfulToolkit-air" allow-bundled-update="true">
    <id>com.fengjianliang.restful.toolkit</id>
    <name>RestfulToolkit-air</name>
    <vendor email="fengjianliang0420@gmail.com" url="https://github.com/Toby-wxu/RestfulToolkit-air">jianliang</vendor>

    <description><![CDATA[
  <h3>A toolkit for RESTful services development.</h3>
  <ul>
    <li>Jump to the handler method behind a URL (<em>Ctrl + \</em>, <em>Ctrl + .</em> or <em>Ctrl + Alt + N</em>),
        with Ant-style matching so <code>/product/{id}</code> resolves <code>/product/42</code>.</li>
    <li>RESTful services tree tool window, scanned on a background thread instead of blocking the UI.</li>
    <li>Built-in HTTP request client: responses are decoded with the charset reported by the server,
        and non-JSON bodies are kept as they are.</li>
    <li>On a handler method: <em>Generate &amp;&amp; Copy Full URL</em>, <em>Relation URL</em>
        (every declared path, one per line), <em>RequestBody (JSON)</em> and <em>Query Param</em>.</li>
    <li>Convert a Java or Kotlin class to sample JSON, compressed JSON or bulk field values;
        format JSON with <em>Ctrl/Cmd + Enter</em>.</li>
  </ul>
  <p>Supports Spring MVC / Spring Boot and JAX-RS, in both Java and Kotlin.</p>
  <p>Maintenance fork of <a href="https://github.com/mrmanzhaow/RestfulToolkit">RestfulToolkit</a> (original author mrmanzhaow),
     under the same Apache-2.0 license. Supports IntelliJ IDEA 2022.2 ~ 2026.3;
     the search popup uses a toolbar-filter layout since 2022.3.</p>

  <hr />
  <h3>一套 RESTful 服务开发辅助工具集。</h3>
  <ul>
    <li>按 URL 直达接口方法（<em>Ctrl \</em>、<em>Ctrl .</em> 或 <em>Ctrl Alt N</em>），支持 Ant 风格路径匹配，
        <code>/product/{productId}</code> 可命中 <code>/product/42</code>。</li>
    <li>Services Tree 工具窗口，接口扫描在后台线程完成，不阻塞界面。</li>
    <li>内置 HTTP 请求工具：按服务端声明的字符集解码，修复中文乱码，非 JSON 响应原样保留。</li>
    <li>接口方法上可复制生成完整 URL、相对 URL（多路径逐行输出）、请求体 JSON 与查询参数。</li>
    <li>Java / Kotlin 实体类转 JSON、压缩 JSON、批量字段值；<em>Ctrl/Cmd + Enter</em> 格式化 JSON。</li>
  </ul>
  <p>支持 Spring 体系（Spring MVC / Spring Boot）与 JAX-RS，支持 Java 和 Kotlin 语言。</p>
  <p>本插件是 <a href="https://github.com/mrmanzhaow/RestfulToolkit">RestfulToolkit</a>（原作者 mrmanzhaow）的维护分支，沿用其 Apache-2.0 授权，支持 IntelliJ IDEA 2022.2 ~ 2026.3，搜索窗口自 2022.3 起使用工具栏筛选布局。</p>
    ]]></description>

    <change-notes><![CDATA[
        <li>1.0.1 支持 IntelliJ IDEA 2026.3；Go to Service 新增 <code>Ctrl .</code> 快捷键（<code>Ctrl \</code> 已被新版 Junie 占用，原快捷键保留）。</li>
        <li>1.0.0 独立版本线起点：支持 IDEA 2022.2 ~ 2026.2；搜索窗口改版（工具栏筛选、紧凑列表、真实 URL 命中占位符）；恢复 Kotlin Spring 路由解析；多路径 URL 生成与复制；修复响应中文乱码；完善 YAML 多文档与请求体 JSON 组装；移除 JSON→POJO、Live Template、代码生成器模块。</li>
        <li>本分支是 RestfulToolkit（作者 mrmanzhaow）及 RestfulToolkit-fix 的维护分支，沿用 Apache-2.0 授权。上游 1.0.3 ~ 2.1.6 的完整更新记录见<a href="https://github.com/Toby-wxu/RestfulToolkit-air#readme">项目 README</a>。</li>
    ]]>
    </change-notes>

    <!-- since-build / until-build and <version> are generated by the intellijPlatform
         pluginConfiguration block in build.gradle.kts; do not duplicate them here. -->

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.jetbrains.kotlin</depends>

    <!-- Kotlin support uses PSI/light classes and works with both compiler modes. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <tipAndTrick feature-id="navigation.popup.service" file="GotoService.html"/>
        <toolWindow id="RestfulToolkit"
                    anchor="right"
                    secondary="false"
                    icon="/icons/service.png"
                    factoryClass="com.zhaow.restful.navigator.RestServicesNavigator$Factory"/>
    </extensions>


    <actions>
        <action id="Popup.PopupChoiceAction"
                class="com.zhaow.restful.popup.action.PopupChoiceAction"
                text="Popup RESTful Toolkit ..."
                description="Popup RESTful Toolkit ...">
            <add-to-group group-id="EditMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift R"/>
        </action>

        <!-- Controller 方法上的生成类操作，收进一个子菜单，避免占满 EditorPopupMenu -->
        <group id="RestfulToolkitGroup" text="RestfulToolkit"
               description="RESTful Toolkit actions for rest method group"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action class="com.zhaow.restful.method.action.GenerateFullUrlAction" id="GenerateFullRestUrl"
                    text="Generate &amp;&amp; Copy Full URL">
            </action>
            <action class="com.zhaow.restful.method.action.GenerateUrlAction" id="GenerateRestUrl"
                    text="Generate &amp;&amp; Copy Relation URL">
            </action>
            <action class="com.zhaow.restful.method.action.GenerateQueryParamJsonAction" id="GenerateRequestBodyJson"
                    text="Generate &amp;&amp; Copy RequestBody (JSON)">
            </action>
            <action class="com.zhaow.restful.method.action.GenerateQueryParamAction" id="BuildQueryParam"
                    text="Generate &amp;&amp; Copy Query Param (Key Value)">
            </action>
        </group>


        <!-- 实体类转 JSON -->
        <action id="ConvertClassToJSONAction" class="com.zhaow.restful.action.ConvertClassToJSONAction"
                text="Convert to JSON" description="Convert to JSON">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <action id="ConvertClassToJSONCompressedAction"
                class="com.zhaow.restful.action.ConvertClassToJSONCompressedAction" text="Convert to JSON (Compressed)"
                description="Convert to JSON (Compressed)">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <action id="ConvertClassToBulkValueAction" class="com.zhaow.restful.action.ConvertClassToBulkValueAction"
                text="Convert to Bulk Value" description="Convert to Bulk Value">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <!-- url 导航 -->
        <action id="Toolkit.GotoService" class="com.zhaow.restful.navigation.action.GotoRequestMappingAction"
                text="_Service" description="Go to Service"
                icon="AllIcons.Actions.Search">
            <add-to-group group-id="GoToTargetEx" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl PERIOD"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt N"/>
        </action>

        <!--刷新-->
        <action id="Toolkit.RefreshServices" class="com.zhaow.restful.navigator.RefreshProjectAction"
                text="Refresh Services in Project"
                icon="AllIcons.Actions.Refresh">
        </action>

        <group id="Toolkit.NavigatorActionsToolbar">
            <reference id="Toolkit.RefreshServices"/>
            <separator/>
            <reference id="Toolkit.GotoService"/>
            <separator/>
        </group>

        <group id="Toolkit.NavigatorServiceMenu">
            <action id="Menu.CopyFullUrlAction" class="com.zhaow.restful.navigator.CopyFullUrlAction"
                    text="Copy Full Url"
                    icon="AllIcons.Actions.Copy">
            </action>
            <action id="Menu.EditSourceAction" class="com.zhaow.restful.navigator.EditSourceAction"
                    text="Jump to Source"
                    icon="AllIcons.Actions.EditSource">
            </action>
            <separator/>
        </group>

    </actions>
    <projectListeners>
        <listener class="com.zhaow.restful.navigator.MyToolwindowListener" topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener" />
    </projectListeners>
</idea-plugin>

